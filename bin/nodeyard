#!/usr/bin/env bash
# nodeyard: manage a homelab cluster (k3s, networking, AI, websites and
# day-to-day operations) from one command. See 'nodeyard help'.

# Checked before anything else, in syntax even bash 3.2 and sh understand.
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ] ||
    { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 3 ]; }; then
    echo "nodeyard needs bash 4.3 or newer (found ${BASH_VERSION:-not bash})." >&2
    echo "Every supported Linux distribution ships a new enough bash; install it with your package manager." >&2
    exit 3
fi

set -Eeuo pipefail

# Find the installation (follows symlinks such as /usr/local/bin/nodeyard).
ny_self="${BASH_SOURCE[0]}"
while [[ -L "$ny_self" ]]; do
    ny_link="$(readlink -- "$ny_self")"
    [[ "$ny_link" == /* ]] || ny_link="$(dirname -- "$ny_self")/${ny_link}"
    ny_self="$ny_link"
done
NY_HOME="$(cd -- "$(dirname -- "$ny_self")/.." && pwd -P)"
unset ny_self ny_link

# shellcheck source=../lib/nodeyard.sh
. "${NY_HOME}/lib/nodeyard.sh"

ny_main "$@"
